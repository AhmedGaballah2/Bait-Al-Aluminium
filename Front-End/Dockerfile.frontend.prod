# ده المفروض يتحط في Front-End/Dockerfile.prod
# multi-stage build: مرحلة بناء + مرحلة نتيجة بس

# Stage 1: بناء الـ React app
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# Stage 2: مجرد نسخ ملفات الـ build الجاهزة
# الـ container ده مش بيشتغل كسيرفر - الـ nginx الرئيسي هو اللي هيخدم الملفات
# فعليًا، إحنا بس محتاجين نحط ملفات الـ build في الـ shared volume
FROM alpine:3.20

COPY --from=build /app/dist /dist

# لما الـ container يشتغل، بينسخ الملفات لمكان الـ volume المشترك مع nginx
# (لازم يتطابق مع الـ mount path بتاع frontend_dist في docker-compose)
CMD ["sh", "-c", "cp -r /dist/* /usr/share/nginx/html/ && tail -f /dev/null"]